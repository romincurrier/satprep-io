{
  "name": "satprep-io",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:approvals": "node scripts/validate-content-approvals.mjs",
    "validate:content-policy": "node scripts/validate-commercial-content-policy.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "validate:marketing-claims": "node scripts/validate-marketing-claims.mjs",
    "validate:accessibility": "node scripts/validate-accessibility.mjs",
    "validate:youth-privacy": "node scripts/validate-youth-privacy.mjs",
    "validate:privacy": "node scripts/validate-privacy-workflow.mjs",
    "validate:private-content": "node --check scripts/import-private-reviewed-content.mjs && node --check scripts/private-content-readiness-report.mjs && node scripts/validate-private-content-workflow.mjs",
    "validate:privileges": "node scripts/validate-privilege-boundaries.mjs",
    "validate:app-origin": "node scripts/validate-app-origin.mjs",
    "validate:security": "node scripts/validate-security.mjs",
    "validate:deployment-security": "node scripts/validate-deployment-security.mjs",
    "validate:secret-boundaries": "node scripts/validate-secret-boundaries.mjs",
    "validate:account-enumeration": "node scripts/validate-account-enumeration.mjs",
    "validate:diagnostic-scope": "node scripts/validate-diagnostic-bank-scope.mjs",
    "validate:diagnostic-submission": "node scripts/validate-diagnostic-submission.mjs",
    "validate:diagnostic-finalization": "node scripts/validate-diagnostic-finalization.mjs",
    "validate:spr": "node scripts/validate-spr.mjs",
    "validate:practice-security": "node scripts/validate-practice-security.mjs",
    "validate:adaptive-practice": "node scripts/validate-adaptive-practice.mjs",
    "validate:learning-authority": "node scripts/validate-learning-authority.mjs",
    "validate:acceptance-flow": "node scripts/validate-acceptance-flow.mjs",
    "validate:parent-progress": "node scripts/validate-parent-progress.mjs",
    "validate:admin-operations": "node scripts/validate-admin-operations.mjs",
    "validate:billing-security": "node scripts/validate-billing-security.mjs",
    "validate:backend-contract": "node --check scripts/verify-live-backend.mjs && node --check scripts/verify-live-content-readiness.mjs",
    "validate:launch": "node scripts/validate-launch.mjs",
    "validate:regression": "node scripts/validate-regression.mjs",
    "brand:inventory": "node scripts/brand-inventory.mjs",
    "content:readiness": "node scripts/content-readiness.mjs",
    "content:review-export": "node scripts/export-content-review.mjs",
    "content:review-validate": "node scripts/validate-content-review.mjs",
    "content:review-apply": "node scripts/apply-content-review.mjs",
    "content:private-readiness": "node scripts/private-content-readiness-report.mjs",
    "content:private-import": "node scripts/import-private-reviewed-content.mjs",
    "content:calibration": "node scripts/content-calibration-report.mjs",
    "verify:backend": "node scripts/verify-live-backend.mjs",
    "verify:live-content": "node scripts/verify-live-content-readiness.mjs",
    "verify:launch-content": "node scripts/verify-live-content-readiness.mjs --strict",
    "build": "npm run validate:content && npm run validate:approvals && npm run validate:content-policy && npm run validate:seo && npm run validate:marketing-claims && npm run validate:accessibility && npm run validate:youth-privacy && npm run validate:privacy && npm run validate:private-content && npm run validate:privileges && npm run validate:app-origin && npm run validate:security && npm run validate:deployment-security && npm run validate:secret-boundaries && npm run validate:account-enumeration && npm run validate:diagnostic-scope && npm run validate:diagnostic-submission && npm run validate:diagnostic-finalization && npm run validate:spr && npm run validate:practice-security && npm run validate:adaptive-practice && npm run validate:learning-authority && npm run validate:acceptance-flow && npm run validate:parent-progress && npm run validate:admin-operations && npm run validate:billing-security && npm run validate:backend-contract && npm run validate:launch && npm run validate:regression && vite build && node scripts/validate-secret-boundaries.mjs --dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "pdfjs-dist": "^4.10.38",
    "xlsx": "^0.18.5"
