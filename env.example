# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only Supabase credential. Never expose this in VITE_* variables or browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Canonical application origin used for billing redirects.
SITE_URL=https://satprep.io

# First-party marketing measurement remains off until privacy/analytics launch approval.
# When enabled later, only privacy-minimized public-site events are accepted server-side.
MARKETING_MEASUREMENT_ENABLED=false

# Stripe server configuration. Keep test mode until an explicit production-launch approval.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_INDIVIDUAL_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_INDIVIDUAL_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_FAMILY_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_FAMILY_ANNUAL=price_REPLACE_ME

# Public billing launch locks. These are enforced on the server for satprep.io/www.satprep.io.
# Preview/non-public hosts can still use Stripe test mode for QA.
PUBLIC_BILLING_ENABLED=false
PUBLIC_BILLING_PORTAL_ENABLED=false

# Safety lock: secure billing endpoints refuse sk_live_* keys unless this is explicitly true.
# Leave false for development, QA, preview, and pre-launch production testing.
ALLOW_LIVE_BILLING=false

# Emergency/test override only. Never enable on the public production host for launch.
ALLOW_PUBLIC_TEST_BILLING=false
